# =============================================================================
# Database (Neon PostgreSQL)
# =============================================================================
# Get your connection string from https://neon.tech → Project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# =============================================================================
# Authentication (NextAuth)
# =============================================================================
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# OAuth Providers (optional — leave blank to disable)
# =============================================================================
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# =============================================================================
# Sentry (error monitoring & performance tracking)
# =============================================================================
# DSN from Sentry project settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""

# Auth token for source map uploads at build time
# Create at https://sentry.io/settings/account/api/auth-tokens/ with scopes: project:releases, org:read
SENTRY_AUTH_TOKEN=""
