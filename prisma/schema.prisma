generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Authentication ──

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  title        String?
  bio          String?
  profileImage String?
  socialLinks  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accounts     Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ── Blog ──

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String
  contentHtml   String?
  coverImageUrl String?
  category      String?
  tags          String[]
  status        String    @default("draft")
  scheduledAt   DateTime?
  likes         Int       @default(0)
  readTimeMin   Int?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, publishedAt])
}

// ── Projects ──

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  techStack   String[]
  liveUrl     String?
  repoUrl     String?
  imageUrl    String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured, order])
}

// ── CV Sections (experience, education, skills) ──

model CVSection {
  id          String   @id @default(cuid())
  type        String
  title       String
  subtitle    String?
  description String?
  logoUrl     String?
  location    String?
  startDate   String?
  endDate     String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, order])
}

// ── Resume Documents ──

model CVDocument {
  id        String   @id @default(cuid())
  filename  String
  url       String
  publicId  String
  fileSize  Int
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isActive])
}

// ── Likes ──

model Like {
  id          String   @id @default(cuid())
  contentId   String
  contentType String
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([contentId, fingerprint])
  @@index([contentId])
}

// ── Site Settings ──

model SiteSettings {
  id              String   @id @default(cuid())
  siteTitle       String   @default("Portfolio")
  siteDescription String?
  accentColor     String   @default("#D4A853")
  logoUrl         String?
  faviconUrl      String?
  footerText      String?
  maintenanceMode Boolean  @default(false)
  showBlog        Boolean  @default(true)
  showProjects    Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}
